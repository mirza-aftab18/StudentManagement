@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<!-- School Information -->
<!-- Dashboard Header -->
<div class="card border-0 shadow-sm mb-5">

    <div class="card-body">

        <div class="row align-items-center">

            <div class="col-md-8">

                <h2 class="fw-bold mb-2">
                    <i class="bi bi-building-fill text-primary"></i>
                    @Model.SchoolName
                </h2>

                <p class="text-muted mb-1">
                    <i class="bi bi-geo-alt-fill text-danger"></i>
                    Tehsil Pasrur, District Sialkot
                </p>

                <p class="text-muted mb-0">
                    <i class="bi bi-credit-card-2-front-fill text-success"></i>
                    EMIS Code:
                    <strong>@Model.EMISCode</strong>
                </p>

            </div>

            <div class="col-md-4 text-md-end mt-3 mt-md-0">

                <h5 class="fw-bold">
                    Welcome, Administrator 👋
                </h5>

                <p class="text-muted mb-0">
                    @DateTime.Now.ToString("dddd, dd MMMM yyyy")
                </p>

            </div>

        </div>

    </div>

</div>

<!-- Dashboard Cards -->
<div class="row g-4">

    <!-- Total Students -->
    <div class="col-lg-3 col-md-6">

        <div class="card shadow border-0 h-100">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <h6 class="text-muted mb-2">
                        Total Students
                    </h6>

                    <h2 class="fw-bold mb-0">
                        @Model.TotalStudents
                    </h2>

                </div>

                <i class="bi bi-people-fill display-4 text-primary"></i>

            </div>

        </div>

    </div>

    <!-- Departments -->
    <div class="col-lg-3 col-md-6">

        <div class="card shadow border-0 h-100">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <h6 class="text-muted mb-2">
                        Departments
                    </h6>

                    <h2 class="fw-bold mb-0">
                        @Model.TotalDepartments
                    </h2>

                </div>

                <i class="bi bi-building display-4 text-success"></i>

            </div>

        </div>

    </div>

    <!-- Male Students -->
    <div class="col-lg-3 col-md-6">

        <div class="card shadow border-0 h-100">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <h6 class="text-muted mb-2">
                        Male Students
                    </h6>

                    <h2 class="fw-bold mb-0">
                        @Model.MaleStudents
                    </h2>

                </div>

                <i class="bi bi-person-fill display-4 text-info"></i>

            </div>

        </div>

    </div>

    <!-- Female Students -->
    <div class="col-lg-3 col-md-6">

        <div class="card shadow border-0 h-100">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <h6 class="text-muted mb-2">
                        Female Students
                    </h6>

                    <h2 class="fw-bold mb-0">
                        @Model.FemaleStudents
                    </h2>

                </div>

                <i class="bi bi-person-heart display-4 text-danger"></i>

            </div>

        </div>

    </div>

</div>

<hr class="my-5" />

<!-- Quick Actions -->
<h3 class="mb-4">
    <i class="bi bi-lightning-charge-fill text-warning"></i>
    Quick Actions
</h3>

<div class="row g-4">

    <!-- Register Student -->
    <div class="col-lg-3 col-md-6">

        <a asp-controller="Home"
           asp-action="VerifyStudent"
           class="text-decoration-none">

            <div class="card border-0 shadow h-100 text-center">

                <div class="card-body py-4">

                    <i class="bi bi-person-plus-fill display-3 text-primary"></i>

                    <h5 class="mt-3 mb-0">
                        Register Student
                    </h5>

                </div>

            </div>

        </a>

    </div>

    <!-- Students List -->
    <div class="col-lg-3 col-md-6">

        <a asp-controller="Home"
           asp-action="StudentsList"
           class="text-decoration-none">

            <div class="card border-0 shadow h-100 text-center">

                <div class="card-body py-4">

                    <i class="bi bi-card-list display-3 text-success"></i>

                    <h5 class="mt-3 mb-0">
                        Students List
                    </h5>

                </div>

            </div>

        </a>

    </div>

    <!-- Add Department -->
    <div class="col-lg-3 col-md-6">

        <a asp-controller="Department"
           asp-action="CreateDepartment"
           class="text-decoration-none">

            <div class="card border-0 shadow h-100 text-center">

                <div class="card-body py-4">

                    <i class="bi bi-building-add display-3 text-warning"></i>

                    <h5 class="mt-3 mb-0 text-dark">
                        Add Department
                    </h5>

                </div>

            </div>

        </a>

    </div>

    <!-- Departments -->
    <div class="col-lg-3 col-md-6">

        <a asp-controller="Department"
           asp-action="Index"
           class="text-decoration-none">

            <div class="card border-0 shadow h-100 text-center">

                <div class="card-body py-4">

                    <i class="bi bi-buildings display-3 text-secondary"></i>

                    <h5 class="mt-3 mb-0 text-dark">
                        Departments
                    </h5>

                </div>

            </div>

        </a>

    </div>

</div>

<div class="row mt-5">

    <!-- Students by Department -->
    <div class="col-lg-8 mb-4">

        <div class="card shadow dashboard-chart-card h-100">
            <div class="card-header bg-primary text-white">

                <h5 class="mb-0">Students by Department</h5>

            </div>

            <div class="card-body">

                <canvas id="departmentChart"></canvas>

            </div>

        </div>

    </div>

    <!-- Male vs Female -->
<div class="col-lg-4 mb-4">

        <div class="card shadow dashboard-chart-card h-100">
            <div class="card-header bg-success text-white">

                <h5 class="mb-0">Male vs Female</h5>

            </div>

            <div class="card-body">

                <canvas id="genderChart"></canvas>

            </div>
                <canvas id="genderChart"></canvas>

            </div>

        </div>

    </div>

</div>

<hr class="my-5" />

<div class="card shadow">

    <div class="card-header bg-primary text-white">

        <h4 class="mb-0">
            🔍 Quick Student Search
        </h4>

    </div>

    <div class="card-body">

        <form asp-controller="Home"
              asp-action="StudentsList"
              method="get">

            <div class="row g-3">

                <!-- Search -->
                <div class="col-md-6">

                    <label class="form-label">
                        Name / CNIC
                    </label>

                    <input name="search"
                           class="form-control"
                           placeholder="Enter Name or CNIC" />

                </div>

                <!-- Department -->
                <div class="col-md-6">

                    <label class="form-label">
                        Department
                    </label>

                    <select name="departmentId"
                            asp-items="Model.Filter.Departments"
                            class="form-select">

                        <option value="">
                            All Departments
                        </option>

                    </select>

                </div>

                <!-- Gender -->
                <div class="col-md-4">

                    <label class="form-label">
                        Gender
                    </label>

                    <select name="gender"
                            class="form-select">

                        <option value="">
                            All
                        </option>

                        <option>Male</option>

                        <option>Female</option>

                    </select>

                </div>

                <!-- Blood Group -->
                <div class="col-md-4">

                    <label class="form-label">
                        Blood Group
                    </label>

                    <select name="bloodGroup"
                            class="form-select">

                        <option value="">All</option>

                        <option>A+</option>
                        <option>A-</option>
                        <option>B+</option>
                        <option>B-</option>
                        <option>AB+</option>
                        <option>AB-</option>
                        <option>O+</option>
                        <option>O-</option>

                    </select>

                </div>

                <!-- Nationality -->
                <div class="col-md-4">

                    <label class="form-label">
                        Nationality
                    </label>

                    <select name="nationality"
                            class="form-select">

                        <option value="">
                            All
                        </option>

                        <option>Pakistan</option>

                        <option>India</option>

                        <option>Saudi Arabia</option>

                    </select>

                </div>

            </div>

            <div class="mt-4">

                <button class="btn btn-primary">

                    Search Students

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Reset

                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    <script>
        const departmentLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DepartmentNames));
        const departmentCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DepartmentStudentCounts));

        new Chart(document.getElementById('departmentChart'), {
            type: 'bar',

            data: {
                labels: departmentLabels,

                datasets: [{
                    label: 'Students',

                    data: departmentCounts,

                    backgroundColor: '#0d6efd',

                    borderColor: '#0b5ed7',

                    borderWidth: 1
                }]
            },

            options: {
                responsive: true,

                plugins: {
                    legend: {
                        display: false
                    }
                },

                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0
                        }
                    }
                }
            }
        });

        const genderLabels = ["Male", "Female"];

        const genderCounts = [
            @Model.MaleCount,
            @Model.FemaleCount
        ];

        new Chart(document.getElementById('genderChart'), {

            type: 'doughnut',

            data: {

                labels: genderLabels,

                datasets: [{

                    data: genderCounts,

                    backgroundColor: [
                        '#0d6efd',
                        '#ff6384'
                    ],

                    borderWidth: 2
                }]
            },

            options: {

                responsive: true,

                plugins: {

                    legend: {

                        position: 'bottom'
                    }
                }
            }
        });
    </script>
}


