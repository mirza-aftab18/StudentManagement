@model Student

@{
    ViewData["Title"] = "Student Details";
}

@{
    int age = DateTime.Today.Year - Model.DateOfBirth.Year;

    if (Model.DateOfBirth.Date > DateTime.Today.AddYears(-age))
    {
        age--;
    }
}

<div class="card shadow">

    <div class="card-header bg-primary text-white">

        <div class="d-flex justify-content-between align-items-center">

            <div>

                <h3 class="mb-0">
                    @Model.Name
                </h3>

                <small>
                    Student Profile
                </small>

            </div>

            <span class="badge bg-light text-dark fs-6">
                ID : @Model.Id
            </span>

        </div>

    </div>

    <div class="card-body">

        <div class="print-header text-center mb-4">

            <h2 class="fw-bold">
                GGPS Lodi Jajja
            </h2>

            <h5>
                Tehsil Pasrur, District Sialkot
            </h5>

            <p>
                <strong>EMIS Code:</strong> 34320564
            </p>

            <hr />

            <h3 class="fw-bold">
                STUDENT PROFILE
            </h3>

        </div>

        <div class="row">

            <!-- Left Profile Card -->
            <div class="col-md-4">

                <div class="card shadow-sm border-0">

                    <div class="card-body text-center">

                        @if (!string.IsNullOrEmpty(Model.ProfileImage))
                        {
                            <img src="~/images/students/@Model.ProfileImage"
                                 class="rounded-circle shadow"
                                 style="width:220px;
                            height:220px;
                            object-fit:cover;
                            border:5px solid #0d6efd;
                            cursor:pointer;"
                                 data-bs-toggle="modal"
                                 data-bs-target="#imageModal"
                                 alt="@Model.Name" />
                        }
                        else
                        {
                            <img src="https://via.placeholder.com/220"
                                 class="rounded-circle shadow"
                                 style="width:220px;
                            height:220px;
                            object-fit:cover;
                            border:5px solid #0d6efd;"
                                 alt="No Image Available" />
                        }

                        <hr />

                        <h3 class="fw-bold mb-1">
                            @Model.Name
                        </h3>

                        <p class="text-muted mb-3">
                            @Model.Department.Name
                        </p>

                        <p class="mb-3">

                            <span class="badge bg-secondary fs-6">

                                Student ID : @Model.Id

                            </span>

                        </p>

                    </div>

                </div>

            </div>

            <!-- Student Information -->
            <div class="col-md-8">

                <table class="table table-bordered">

                    <tr>
                        <th width="30%">Name</th>
                        <td>@Model.Name</td>
                    </tr>

                    <tr>
                        <th>Father Name</th>
                        <td>@Model.FatherName</td>
                    </tr>

                    <tr>
                        <th>Gender</th>
                        <td>@Model.Gender</td>
                    </tr>

                    <tr>
                        <th>Date of Birth</th>
                        <td>@Model.DateOfBirth.ToString("dd MMM yyyy")</td>
                    </tr>

                    <tr>
                        <th>Age</th>
                        <td>@age Years</td>
                    </tr>

                    <tr>
                        <th>Email</th>
                        <td>@Model.Email</td>
                    </tr>

                    <tr>
                        <th>Phone</th>
                        <td>@Model.PhoneNumber</td>
                    </tr>

                    <tr>
                        <th>CNIC</th>
                        <td>@Model.CNIC</td>
                    </tr>

                    <tr>
                        <th>Nationality</th>
                        <td>@Model.Nationality</td>
                    </tr>

                    <tr>
                        <th>Blood Group</th>
                        <td>@Model.BloodGroup</td>
                    </tr>

                    <tr>
                        <th>Department</th>
                        <td>@Model.Department.Name</td>
                    </tr>

                    <tr>
                        <th>Address</th>
                        <td>@Model.Address</td>
                    </tr>

                </table>

            </div>

        </div>

        <div class="mt-4">

            <button type="button"
                    class="btn btn-primary"
                    onclick="window.print()">

                🖨 Print

            </button>

            <a asp-action="DownloadPdf"
               asp-route-id="@Model.Id"
               class="btn btn-danger">
                📄 Download PDF
            </a>

            <a asp-action="StudentsList"
               class="btn btn-secondary">
                Back
            </a>

            <a asp-action="EditStudent"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Edit
            </a>

        </div>

    </div>

</div>

<!-- Image Preview Modal -->

<div class="modal fade"
     id="imageModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    @Model.Name
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body text-center">

                @if (!string.IsNullOrEmpty(Model.ProfileImage))
                {
                    <img src="~/images/students/@Model.ProfileImage"
                         class="img-fluid rounded"
                         style="max-width:100%;
                    max-height:75vh;
                    width:auto;
                    object-fit:contain;"
                         alt="@Model.Name" />
                }

            </div>

        </div>

    </div>

</div>