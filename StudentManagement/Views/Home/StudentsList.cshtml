@model List<Student>
<div class="row mb-3">

    <div class="col-md-12">

        <form asp-action="StudentsList" method="get">

            <div class="d-flex justify-content-between align-items-center mb-4 mt-4">

                <!-- Left Side : Search -->
                <div class="d-flex align-items-center">

                    <input type="text"
                           name="search"
                           value="@Context.Request.Query["search"]"
                           class="form-control"
                           placeholder="Search by Name, Email, CNIC, Phone"
                           style="width:340px;" />

                    <button type="submit"
                            class="btn btn-primary ms-2 text-nowrap">
                        Search
                    </button>

                    <a asp-action="StudentsList"
                       class="btn btn-secondary ms-2 text-nowrap">
                        Clear
                    </a>

                </div>

                <!-- Right Side : Export -->
                <div>
                    <a asp-action="ExportToExcel"
                       class="btn btn-success text-nowrap">
                        <i class="bi bi-file-earmark-excel me-1"></i>
                        Export Excel
                    </a>
                </div>


            </div>

        </form>
        

    </div>

</div>

<div class="table-responsive">
    <table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Image</th>
                <th>
                    <a asp-action="StudentsList"
                       asp-route-search="@ViewBag.Search"
                       asp-route-page="@ViewBag.CurrentPage"
                       asp-route-sortOrder="@ViewBag.NameSort"
                       class="text-white text-decoration-none">

                        Name

                        @if (ViewBag.CurrentSort == "name")
                        {
                            <span>▲</span>
                        }
                        else if (ViewBag.CurrentSort == "name_desc")
                        {
                            <span>▼</span>
                        }
                        else
                        {
                            <span>⇅</span>
                        }
                    </a>
                </th>
            <th>Father Name</th>
            <th>Gender</th>
                <th>
                    <a asp-action="StudentsList"
                       asp-route-search="@ViewBag.Search"
                       asp-route-page="@ViewBag.CurrentPage"
                       asp-route-sortOrder="@ViewBag.DobSort"
                       class="text-white text-decoration-none">

                        Date Of Birth

                        @if (ViewBag.CurrentSort == "dob")
                        {
                            <span>▲</span>
                        }
                        else if (ViewBag.CurrentSort == "dob_desc")
                        {
                            <span>▼</span>
                        }
                        else
                        {
                            <span>⇅</span>
                        }

                    </a>
                </th>
            <th>Email</th>
            <th>Phone</th>
            <th>CNIC</th>
            <th>Nationality</th>
            <th>Blood Group</th>
                <th>
                    <a asp-action="StudentsList"
                       asp-route-search="@ViewBag.Search"
                       asp-route-page="@ViewBag.CurrentPage"
                       asp-route-sortOrder="@ViewBag.DepartmentSort"
                       class="text-white text-decoration-none">

                        Department

                        @if (ViewBag.CurrentSort == "department")
                        {
                            <span>▲</span>
                        }
                        else if (ViewBag.CurrentSort == "department_desc")
                        {
                            <span>▼</span>
                        }
                        else
                        {
                            <span>⇅</span>
                        }

                    </a>
                </th>
                <th>View</th>
                <th>Edit</th>
                <th>Delete</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Id</td>
                <td>
                    @if (!string.IsNullOrEmpty(student.ProfileImage))
                    {
                        <img src="~/images/students/@student.ProfileImage"
                             width="70"
                             height="70"
                             class="rounded-circle" />
                    }
                    else
                    {
                        <span>No Image</span>
                    }
                </td>
                
                <td>@student.Name</td>
                <td>@student.FatherName</td>
                <td>@student.Gender</td>
                    <td>@student.DateOfBirth.ToString("dd-MM-yyyy")</td>
                <td>@student.Email</td>
                <td>@student.PhoneNumber</td>
                <td>@student.CNIC</td>
                <td>@student.Nationality</td>
                <td>@student.BloodGroup</td>
                <td>@student.Department.Name</td>

                    <td>
                        <a asp-action="StudentDetails"
                           asp-route-id="@student.Id"
                           class="btn btn-info btn-sm">
                            View
                        </a>
                    </td>

                <td>
                    <a asp-action="EditStudent"
                       asp-route-id="@student.Id"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>
                </td>

                <td>
                    <form asp-action="DeleteStudent"
                          asp-route-id="@student.Id"
                          method="post">

                        <button type="submit"
                                class="btn btn-danger btn-sm"
                                onclick="return confirm('Are you sure you want to delete this student?');">
                            Delete
                        </button>

                    </form>
                </td>

            </tr>
        }

    </tbody>

</table>
</div>
<nav class="mt-3">

    <ul class="pagination justify-content-center">

        <!-- Previous -->
        <!-- Previous -->
        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link"
               asp-action="StudentsList"
               asp-route-page="@(ViewBag.CurrentPage - 1)"
               asp-route-search="@ViewBag.Search"
               asp-route-sortOrder="@ViewBag.CurrentSort">
                Previous
            </a>
        </li>

        <!-- Page Numbers -->
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                <a class="page-link"
                   asp-action="StudentsList"
                   asp-route-page="@i"
                   asp-route-search="@ViewBag.Search"
                   asp-route-sortOrder="@ViewBag.CurrentSort">
                    @i
                </a>
            </li>
        }

        <!-- Next -->
        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
            <a class="page-link"
               asp-action="StudentsList"
               asp-route-page="@(ViewBag.CurrentPage + 1)"
               asp-route-search="@ViewBag.Search"
               asp-route-sortOrder="@ViewBag.CurrentSort">
                Next
            </a>
        </li>

    </ul>

</nav>